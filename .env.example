# Flask Application Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1

# Security Keys (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-this-in-production-to-a-cryptographically-secure-random-32-byte-key

# Database Path (default is secure_login.db in project root)
DATABASE_PATH=secure_login.db

# Session Security
SESSION_COOKIE_SECURE=False  # Set to True when deploying behind HTTPS
PERMANENT_SESSION_LIFETIME_MINUTES=30

# Rate Limiting
LOGIN_RATE_LIMIT=5/minute
REGISTRATION_RATE_LIMIT=3/minute
